---
// Interactive threshold playground: the same decision rules as the shipped flows, run in the browser.
// No request is made: every number is typed or dragged by the reader.
interface Props {
  labels: {
    toolTitle: string;
    risks: [string, string][];
    askAt: string;
    denyAt: string;
    verdict: string;
    allow: string;
    ask: string;
    deny: string;
    wakeTitle: string;
    prob: string;
    sleepBelow: string;
    judgedFrom: string;
    outcome: string;
    sleep: string;
    unsure: string;
    judged: string;
  };
}
const { labels } = Astro.props;
---

<div class="umbral" data-labels={JSON.stringify(labels)}>
  <section class="card" aria-labelledby="u-tool">
    <h3 id="u-tool">{labels.toolTitle}</h3>
    {labels.risks.map(([id, text]) => (
      <label class="row">
        <span>{text}</span>
        <input type="range" min="0" max="1" step="0.01" value="0.3" data-risk={id} />
        <output data-out={id}>0.30</output>
      </label>
    ))}
    <label class="row">
      <span>{labels.askAt}</span>
      <input type="range" min="0" max="1" step="0.01" value="0.55" data-ask />
      <output data-out="ask">0.55</output>
    </label>
    <label class="row">
      <span>{labels.denyAt}</span>
      <input type="range" min="0" max="1" step="0.01" value="0.85" data-deny />
      <output data-out="deny">0.85</output>
    </label>
    <p class="result" aria-live="polite">{labels.verdict}: <strong data-verdict></strong></p>
  </section>

  <section class="card" aria-labelledby="u-wake">
    <h3 id="u-wake">{labels.wakeTitle}</h3>
    <label class="row">
      <span>{labels.prob}</span>
      <input type="range" min="0" max="1" step="0.01" value="0.4" data-p />
      <output data-out="p">0.40</output>
    </label>
    <label class="row">
      <span>{labels.sleepBelow}</span>
      <input type="range" min="0" max="1" step="0.01" value="0.3" data-sleep />
      <output data-out="sleep">0.30</output>
    </label>
    <label class="row">
      <span>{labels.judgedFrom}</span>
      <input type="range" min="0" max="1" step="0.01" value="0.5" data-judged />
      <output data-out="judged">0.50</output>
    </label>
    <p class="result" aria-live="polite">{labels.outcome}: <strong data-outcome></strong></p>
  </section>
</div>

<style>
  .umbral { display: grid; gap: 1.25rem; margin-block: 1.5rem; }
  .card { border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; padding: 1rem 1.25rem; background: var(--sl-color-bg-nav); }
  .card h3 { margin-top: 0; }
  .row { display: grid; grid-template-columns: minmax(8rem, 12rem) 1fr 3rem; gap: 0.75rem; align-items: center; margin-block: 0.4rem; }
  .row output { font-variant-numeric: tabular-nums; text-align: right; }
  .result { margin-bottom: 0; font-size: var(--sl-text-lg); }
  @media (max-width: 40rem) { .row { grid-template-columns: 1fr 3rem; } .row span { grid-column: 1 / -1; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.umbral');
  if (root) {
    const L = JSON.parse(root.dataset.labels ?? '{}');
    const num = (el: Element | null) => Number((el as HTMLInputElement).value);
    const set = (name: string, v: number) => {
      const o = root.querySelector(`[data-out="${name}"]`);
      if (o) o.textContent = v.toFixed(2);
    };
    const ids: string[] = L.risks.map((r: [string, string]) => r[0]);
    const verdictEl = root.querySelector('[data-verdict]')!;
    const outcomeEl = root.querySelector('[data-outcome]')!;

    function tool() {
      const risks = ids.map((id) => num(root!.querySelector(`[data-risk="${id}"]`)));
      const ask = num(root!.querySelector('[data-ask]'));
      const deny = num(root!.querySelector('[data-deny]'));
      ids.forEach((id, i) => set(id, risks[i]));
      set('ask', ask);
      set('deny', deny);
      // Same order as the flow's route: the first true rule wins, deny before ask.
      const v = risks.some((r) => r >= deny) ? L.deny : risks.some((r) => r >= ask) ? L.ask : L.allow;
      verdictEl.textContent = v;
    }
    function wake() {
      const p = num(root!.querySelector('[data-p]'));
      const sleep = num(root!.querySelector('[data-sleep]'));
      const judged = num(root!.querySelector('[data-judged]'));
      set('p', p);
      set('sleep', sleep);
      set('judged', judged);
      // Half-open intervals, as in the flow: [0, sleep) sleeps, [sleep, judged) is unsure, [judged, 1] is judged.
      outcomeEl.textContent = p < sleep ? L.sleep : p < judged ? L.unsure : L.judged;
    }
    root.querySelectorAll('input').forEach((i) =>
      i.addEventListener('input', () => (i.closest('section')?.getAttribute('aria-labelledby') === 'u-tool' ? tool() : wake())),
    );
    tool();
    wake();
  }
</script>
